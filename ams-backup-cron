# 资产管理系统 - 数据库自动备份定时任务
# 安装：sudo cp ams-backup-cron /etc/cron.d/ams-backup-cron
# 验证：sudo crontab -l 或 tail -f /var/log/cron

# 每日凌晨 02:00 备份数据库（保留30天）
0 2 * * * root /bin/bash /opt/asset-management-system/backup-db.sh daily >> /opt/asset-management-system/logs/backup-daily.log 2>&1

# 每月1日凌晨 03:00 备份大版本数据库（保留12个月）
0 3 1 * * root /bin/bash /opt/asset-management-system/backup-db.sh monthly >> /opt/asset-management-system/logs/backup-monthly.log 2>&1

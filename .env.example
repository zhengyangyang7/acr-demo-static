# ============================================================
# AMS 资产管理系统 - 环境变量模板
# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# ⚠️ .env 含敏感密钥，切勿提交到 git（已在 .gitignore 排除）
# ============================================================

# Lark 开放平台应用凭证（自建应用）
# 获取位置：open.larksuite.com → 你的应用 → 凭证与基础信息
LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here

# Lark OAuth 回调地址（必须与开放平台「安全设置」里配置的重定向 URL 一致）
LARK_REDIRECT_URI=https://aap.hknhw.com
